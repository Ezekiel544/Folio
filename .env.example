# ── Folio environment ───────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# ── Required secrets (generate long random values) ──────────────────────
# openssl rand -hex 32
PHAROS_API_KEY=replace-with-a-long-random-business-api-key
PHAROS_RECEIPT_SECRET=replace-with-a-long-random-signing-secret
PHAROS_SESSION_SECRET=replace-with-a-long-random-session-secret

# ── Database (Supabase Postgres) ─────────────────────────────────────────
# Required in production. Use the "Transaction pooler" connection string from
# Supabase → Settings → Database → Connection string. NEVER commit it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Wallet connection (RainbowKit / WalletConnect) ───────────────────────
# Free project ID from https://cloud.walletconnect.com. Required for mobile
# and in-browser wallet connections (QR + deep links). Public/safe to expose.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Client-side issuing (demo only) ─────────────────────────────────────
# Leave unset/false in production. Production issues via the SDK + API key.
# PHAROS_ALLOW_CLIENT_ISSUE=false

# ── Onchain anchoring (ReceiptRegistry.sol) — optional ──────────────────
# Leave PHAROS_RPC_URL / REGISTRY_ADDRESS / ISSUER_PRIVATE_KEY unset to run
# fully offchain; anchoring is then skipped (onchain.configured: false).
#
# Local hardhat node:
#   npx hardhat node                          # terminal 1
#   npm run deploy                            # terminal 2 (prints address)
# PHAROS_RPC_URL=http://127.0.0.1:8545
#
# Sepolia testnet:
#   1) fund a fresh wallet with Sepolia ETH (faucet)
#   2) SEPOLIA_RPC_URL=<provider url> PHAROS_ISSUER_PRIVATE_KEY=<key> npm run deploy:sepolia
#   3) fill the values printed by the deploy script below
# PHAROS_RPC_URL=https://sepolia.infura.io/v3/<project-id>
PHAROS_RPC_URL=
PHAROS_ISSUER_PRIVATE_KEY=
PHAROS_ISSUER_ADDRESS=
PHAROS_RECEIPT_REGISTRY_ADDRESS=

# RPC used ONLY by `npm run deploy:sepolia` (Hardhat). Not read by the app.
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<project-id>

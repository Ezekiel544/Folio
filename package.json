{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:pharos": "hardhat run scripts/deploy.ts --network pharos",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "wallet:new": "node -e \"const {Wallet}=require('ethers');const w=Wallet.createRandom();console.log('address:    ',w.address);console.log('privateKey: ',w.privateKey);\"",
    "test": "hardhat test && node --env-file-if-exists=.env --test 'test/lib/**/*.test.ts'",
    "test:contract": "hardhat test",
    "test:lib": "node --env-file-if-exists=.env --test 'test/lib/**/*.test.ts'"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.103.1",
    "ethers": "^6.17.0",
    "next": "14.2.5",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "viem": "^2.56.7",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
